  <decision id="application" name="Определить сервисы">
    <variable id="Variable_1" name="Определить сервисы" typeRef="Any" />
    <decisionTable id="DecisionTable_1x2j7hl" hitPolicy="COLLECT">
      <input id="Input_1">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>customerType</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Вызываемые сервисы" name="services" typeRef="string" biodi:width="192" />
      <rule id="DecisionRule_1nolbqt">
        <inputEntry id="UnaryTests_0o2yagf">
          <text>"partner"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1unpedp">
          <text>"partnerSystem"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_08baztm">
        <inputEntry id="UnaryTests_1q36kpl">
          <text>"partner", "new"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_13t2gqr">
          <text>"publicSystem"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1rslpl4">
        <inputEntry id="UnaryTests_1edq3ef">
          <text>"existing"</text>
